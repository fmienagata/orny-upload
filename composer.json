{
  "name": "docaposte/uploadbundle",
  "description": "Upload file bundle in safe-deposit box",
  "license": "proprietary",
  "authors": [
    {
      "name": "cbezo",
      "email": "charles.bezo@docaposte.fr"
    }
  ],
  "require": {
    "php": ">=8.0.2",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "api-platform/core": "^3.0",
    "doctrine/annotations": "^1.0",
    "doctrine/doctrine-bundle": "^2.7",
    "doctrine/mongodb-odm-bundle": "^4.5",
    "fpdf/fpdf": "^1.85",
    "gedmo/doctrine-extensions": "^3.10",
    "howtomakeaturn/pdfinfo": "1.*",
    "lexik/jwt-authentication-bundle": "^2.16",
    "mongodb/mongodb": "1.13.1",
    "nelmio/cors-bundle": "^2.2",
    "paragonie/sodium_compat": "^1.19",
    "phpdocumentor/reflection-docblock": "^5.3",
    "phpstan/phpdoc-parser": "^1.13",
    "sensio/framework-extra-bundle": "^6.2",
    "setasign/fpdf": "^1.8",
    "setasign/fpdi": "^2.3",
    "sineflow/clamav": "^1.1",
    "symfony/asset": "^6.2",
    "symfony/console": "^6.2",
    "symfony/doctrine-messenger": "^6.2",
    "symfony/dotenv": "^6.2",
    "symfony/expression-language": "^6.2",
    "symfony/filesystem": "^6.2",
    "symfony/flex": "^2",
    "symfony/form": "^6.2",
    "symfony/framework-bundle": "^6.2",
    "symfony/gateway-api-notifier": "^6.2",
    "symfony/http-client": "^6.2",
    "symfony/intl": "^6.2",
    "symfony/mailer": "^6.2",
    "symfony/mime": "^6.2",
    "symfony/monolog-bundle": "^3.8",
    "symfony/notifier": "^6.2",
    "symfony/process": "^6.2",
    "symfony/property-access": "^6.2",
    "symfony/property-info": "^6.2",
    "symfony/proxy-manager-bridge": "^6.2",
    "symfony/runtime": "^6.2",
    "symfony/security-bundle": "^6.2",
    "symfony/serializer": "^6.2",
    "symfony/string": "^6.2",
    "symfony/translation": "^6.2",
    "symfony/twig-bundle": "^6.2",
    "symfony/uid": "^6.2",
    "symfony/validator": "^6.2",
    "symfony/web-link": "^6.2",
    "symfony/workflow": "^6.2",
    "symfony/yaml": "^6.2",
    "twig/extra-bundle": "^2.12|^3.0",
    "twig/twig": "^2.12|^3.0",
    "vich/uploader-bundle": "*"
  },
  "config": {
      "allow-plugins": {
          "composer/package-versions-deprecated": true,
          "symfony/flex": true,
          "symfony/runtime": true
      },
      "optimize-autoloader": true,
      "preferred-install": {
          "*": "dist"
      },
      "sort-packages": true
  },
  "autoload": {
      "psr-4": {
          "UploadBundle\\": "src/"
      }
  },
  "autoload-dev": {
      "psr-4": {
          "UploadBundle\\Tests\\": "tests/"
      }
  },
  "replace": {
      "symfony/polyfill-ctype": "*",
      "symfony/polyfill-iconv": "*",
      "symfony/polyfill-php72": "*",
      "symfony/polyfill-php73": "*",
      "symfony/polyfill-php74": "*",
      "symfony/polyfill-php80": "*"
  },
  "scripts": {
      "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
      "post-install-cmd": [
          "@auto-scripts"
      ],
      "post-update-cmd": [
          "@auto-scripts"
      ]
  },
  "conflict": {
      "symfony/symfony": "*"
  },
  "extra": {
      "symfony": {
          "allow-contrib": false,
          "require": "^6.2"
      }
  },
  "require-dev": {
    "api-platform/schema-generator": "^5.1",
    "codeception/codeception": "^5.0",
    "codeception/mockery-module": "*",
    "codeception/module-asserts": "*",
    "codeception/module-mongodb": "*",
    "codeception/module-phpbrowser": "^3.0",
    "codeception/module-rest": "*",
    "codeception/module-symfony": "*",
    "phploc/phploc": "^7.0",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^9.5",
    "symfony/browser-kit": "^6.2",
    "symfony/css-selector": "^6.2",
    "symfony/debug-bundle": "^6.2",
    "symfony/maker-bundle": "^1.48",
    "symfony/phpunit-bridge": "^6.1",
    "symfony/stopwatch": "^6.2",
    "symfony/web-profiler-bundle": "^6.2"
  }
}
