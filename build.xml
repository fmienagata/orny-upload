<?xml version="1.0" encoding="UTF-8"?>
<project name="AeSv8" default="full-build" basedir=".">
    <!-- set global properties for this build-->

    <property environment="env" />
    <property name="version" value="${env.BUILD_DISPLAY_NAME}" />
    <property name="build" value="${env.BUILD_NUMBER}" />

    <target name="full-build"
            depends="clean,prepare,build-version,vendors,prepare-env,prepare-package"
            description="Performs static analysis, runs the tests"/>

    <target name="quickest-build"
            depends="clean,prepare,build-version,vendors,prepare-env,prepare-package"
            description="Performs a lint check without running the tests"/>

    <target name="clean"
            unless="clean.done"
            description="Cleanup build artifacts">
        <delete dir="${basedir}/build/logs"/>
        <delete dir="${basedir}/vendor/composer"/>
        <delete dir="${basedir}/vendor/lexik"/>
        <delete dir="${basedir}/vendor/symfony"/>
        <delete>
            <fileset dir="." includes="**/*.log"/>
        </delete>
        <delete>
            <fileset dir="." includes="**/*.tar.gz"/>
        </delete>
        <property name="clean.done" value="true"/>
    </target>

    <target name="prepare"
            unless="prepare.done"
            depends="clean"
            description="Prepare for build">
        <mkdir dir="${basedir}/build/logs"/>
        <mkdir dir="${basedir}/build/packages"/>
        <property name="prepare.done" value="true"/>
    </target>
    <target name="build-version" description="Build version">
        <exec executable="sh" failonerror="true">
            <arg value="${basedir}/bin/build.sh" />
            <arg value="-v" />
            <arg value="${version}" />
            <arg value="-b" />
            <arg value="${build}" />
        </exec>
    </target>
    <target name="vendors" description="Install vendors">
        <exec executable="/opt/remi/php82/root/bin/php" failonerror="true">
            <arg value="-d"/>
            <arg value="memory_limit=-1"/>
            <arg value="${basedir}/composer.phar"/>
            <arg value="update"/>
            <arg value="--no-plugins"/>
            <arg value="--no-scripts"/>
            <arg value="--optimize-autoloader" />
            <arg value="--classmap-authoritative" />
        </exec>
    </target>
    <target name="prepare-env" description="Prepare .env file">
        <exec executable="/opt/remi/php82/root/bin/php" failonerror="true">
            <arg value="${basedir}/composer.phar" />
            <arg value="dump-env" />
            <arg value="dev" />
        </exec>
        <exec executable="/opt/remi/php82/root/bin/php" failonerror="true">
            <arg value="${basedir}/composer.phar" />
            <arg value="dump-autoload" />
            <arg value="--optimize" />
            <arg value="--classmap-authoritative" />
        </exec>
        <exec executable="/opt/remi/php82/root/bin/php" failonerror="true">
            <arg value="${basedir}/bin/console" />
            <arg value="lexik:jwt:generate-keypair" />
            <arg value="--overwrite" />
        </exec>
    </target>
    <target name="prepare-package" description="Prepare tar gz package.">
        <exec executable="ls" failonerror="true">
            <arg value="-alth" />
        </exec>
        <exec executable="echo" failonerror="true">
            <arg value="${version}" />
        </exec>
        <exec executable="tar" failonerror="true">
            <arg value="--exclude=.git" />
            <arg value="--exclude=.idea" />
            <arg value="--exclude=var/cache" />
            <arg value="--exclude=var/log" />
            <arg value="--exclude=build" />
            <arg value="--exclude=build.xml" />
            <arg value="--exclude=build.deployment.xml" />
            <arg value="--exclude=backup.api.tar.gz" />
            <arg value="--exclude=backup.${build}.api.tar.gz" />
            <arg value="--exclude=${build}.api.tar.gz" />
            <arg value="-zcvf" />
            <arg value="build/packages/${version}.api.tar.gz" />
            <arg value="." />
        </exec>
    </target>
</project>
