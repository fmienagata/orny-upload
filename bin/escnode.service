[Unit]
Description=EscNode Java driven simple service
After=syslog.target network.target

[Service]
SuccessExitStatus=143

User=escnode
Group=escnode

Type=simple

Environment="JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64/jre/"
WorkingDirectory=/home/escnode/esc
ExecStart=/usr/lib/jvm/java-8-openjdk-amd64/jre/bin/java -jar /home/escnode/esc/EscNode.jar -name "EscDgtt" -configPath "config.xml" -portNoSSL 4110 -port 4100 -logLevel TRACE -typeNode MIXTE -site EscDgtt -nbWorker 64
ExecStop=/bin/kill -15 $MAINPID

[Install]
WantedBy=multi-user.target