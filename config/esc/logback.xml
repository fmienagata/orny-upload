<?xml version="1.0" encoding="UTF-8" ?>
<configuration>

	<property name="PATRON_LOGS"
		value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%5.5level] %36.36logger{36} - %msg%n" />
	<property name="TAILLE_MAX_LOGS" value="ESC_LOG_MAX_SIZE" />
	<property name="REPERTOIRE_RACINE_LOGS" value="ESC_LOG_DIR" />
	<property name="REPERTOIRE_APACHE_ACCESS_LOGS" value="ESC_LOG_DIR/logaa/" />
	<property name="REPERTOIRE_APACHE_ERROR_LOGS" value="ESC_LOG_DIR/logae/" />
	<property name="NBR_FICHIERS_CONSERVES" value="ESC_LOG_NB_FILE" />
	<property name="FORMAT" value="ESC_LOG_EXTENSION" /> <!-- log.zip for zip format -->

	<appender name="console" class="ch.qos.logback.core.ConsoleAppender">
		<Target>System.out</Target>
		<encoder>
			<Pattern>${PATRON_LOGS}</Pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<appender name="esc"
		class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${REPERTOIRE_RACINE_LOGS}/esc.log</file>
		<append>true</append>

		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${REPERTOIRE_RACINE_LOGS}/esc_%d{yyyy-MM-dd}_%i.${FORMAT}
			</fileNamePattern>

			<timeBasedFileNamingAndTriggeringPolicy
				class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
				<maxFileSize>${TAILLE_MAX_LOGS}</maxFileSize>
			</timeBasedFileNamingAndTriggeringPolicy>

			<maxHistory>${NBR_FICHIERS_CONSERVES}</maxHistory>
		</rollingPolicy>

		<!-- encoders are assigned the type ch.qos.logback.classic.encoder.PatternLayoutEncoder 
			by default -->
		<encoder>
			<Pattern>${PATRON_LOGS}</Pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<appender name="esc.access"
		class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${REPERTOIRE_APACHE_ACCESS_LOGS}/esc.access.log</file>
		<append>true</append>

		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${REPERTOIRE_APACHE_ACCESS_LOGS}/esc.access_%d{yyyy-MM-dd}_%i.${FORMAT}
			</fileNamePattern>

			<timeBasedFileNamingAndTriggeringPolicy
				class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
				<maxFileSize>${TAILLE_MAX_LOGS}</maxFileSize>
			</timeBasedFileNamingAndTriggeringPolicy>

			<maxHistory>${NBR_FICHIERS_CONSERVES}</maxHistory>
		</rollingPolicy>

		<!-- encoders are assigned the type ch.qos.logback.classic.encoder.PatternLayoutEncoder 
			by default -->
		<encoder>
			<Pattern>${PATRON_LOGS}</Pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<appender name="esc.error"
		class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${REPERTOIRE_APACHE_ERROR_LOGS}/esc.error.log</file>
		<append>true</append>

		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${REPERTOIRE_APACHE_ERROR_LOGS}/esc.error_%d{yyyy-MM-dd}_%i.${FORMAT}
			</fileNamePattern>

			<timeBasedFileNamingAndTriggeringPolicy
				class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
				<maxFileSize>${TAILLE_MAX_LOGS}</maxFileSize>
			</timeBasedFileNamingAndTriggeringPolicy>

			<maxHistory>${NBR_FICHIERS_CONSERVES}</maxHistory>
		</rollingPolicy>

		<!-- encoders are assigned the type ch.qos.logback.classic.encoder.PatternLayoutEncoder 
			by default -->
		<encoder>
			<Pattern>${PATRON_LOGS}</Pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="esc" />
		<appender-ref ref="console" />
	</root>

	<!-- LOGGERS -->
	<logger name="org.apache.http" level="DEBUG" />
	<logger name="org.apache.http.wire" level="ERROR" />
	<logger name="java.security" level="TRACE" />

	<logger name="com.docapost.dps.esc.utils.tools.log.info" level="INFO"
		additivity="false">
		<appender-ref ref="esc.access" />
	</logger>

	<logger name="com.docapost.dps.esc.utils.tools.log.error" level="ERROR"
		additivity="false">
		<appender-ref ref="esc.error" />
	</logger>

	<logger name="com.docapost.dps.esc" level="TRACE" />

</configuration>